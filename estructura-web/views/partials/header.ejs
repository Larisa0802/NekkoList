<header class="main-header">

  <div class="logo">
    <a href="/">
      <img src="/img/logo.png" alt="logoImg">
      <p class="logoName">NekkoList</p>
    </a>
  </div>

  <nav class="navbar">
    <!-- Opciones visibles para TODOS -->
    <a href="/inicio">Inicio</a>
    <a href="/catalog">Catalogo</a>
    <a href="/contact">Contacto</a>

    <!--Comprueba si el usuario esta o no registrado o si es admin-->
    <!-- Usuario NO registrado -->
    <% if (!user) { %>
      <a href="/logIn">Login</a>
      <a href="/register">Registro</a>
    <% } %>

    <!-- Usuario registrado -->
    <% if (user) { %>
      <a href="/profile">Perfil</a>
      <a href="/logOut" id="cerrarSes">Cerrar sesión</a>
    <% } %>

  </nav>

</header>
