<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/estilos.css">
    <link rel="icon" href="/favicon.ico">
    <title>NekkoList - Registro</title>
</head>

<body>
    <%- include("../partials/header") %><!--Header-->
        <main class="register-div">
            <form action="/signup" method="post">
                <p>Registrate<img src="/img/registerPet.png" alt="registerPet" class="pet"></p>
                <p>Email: <input name="email" type="text" /></p>
                <p>Contraseña: <input name="password" type="password" /></p>
                <p>Nombre: <input name="name" type="text" /></p>
                <a href="login.html"></a>
                <input type="submit" value="Registrarse" />
                <%if(errorR){%>
                    <h3 id="error">
                        <%= errorR.mensaje %>
                    </h3>
                        <%}%>
            </form>


        </main>
        <%- include("../partials/footer") %><!--Footer-->

</body>

</html>