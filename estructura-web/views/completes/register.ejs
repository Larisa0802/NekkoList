<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/estilos.css">
    <link rel="icon" href="/favicon.ico">
    <title>Registro</title>
</head>

<body>
    <%- include("../partials/header") %><!--Header-->
        <main class="register-div">
        <form action="/signup" method="post">
            <p>Registrate</p>
            <p>Email: <input name="email" type="text" /></p>
            <p>Contraseña: <input name="password" type="password" /></p>
            <p>Nombre: <input name="name" type="text" /></p>
            <a href="login.html"></a>
            <input type="submit" value="Registrarse" />
        </form>
        <div id="msg"></div>

    </main>
        <%- include("../partials/footer") %>
            <!--Footer-->

            <script>
                const form = document.querySelector("form")
                const mensaje = document.getElementById("msg")
                
                form.addEventListener("submit", (e) => {
                    const email = document.getElementsByName("email")[0].value
                    const pass = document.getElementsByName("password")[0].value 
                    const nombre = document.getElementsByName("name")[0].value
                    mensaje.innerHTML = ""
                    if (!pass || !email || !nombre) {
                        e.preventDefault()
                        mensaje.innerHTML = "<h2 style='color:red'>Los campos no pueden estar vacios</h2>";
                        return
                    }

                    if (pass.length < 6) {
                        e.preventDefault()
                        mensaje.innerHTML = "<h2 style='color:red'>La contraseña debe tener mínimo 6 caracteres</h2>";
                        return
                    }
                })
            </script>
</body>

</html>