<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <link rel="icon" href="/favicon.ico">
    <title>NekkoList - Contacto</title>
</head>
<body>
    <%- include("../partials/header") %> <!--Header-->

    <main class="contactoDiv">
        <h1 id="titC">¡Contactanos!<img src="/img/contactPet.png" alt="contactPet" class="pet"></h1>
        <section class="contactos">
            <form>
                <label for="nombre">Nombre: <span></label><input id="nombre" type="text" placeholder="Nombre" required><br><br>
                <label for="email">Email:</label><input id="email" type="text" placeholder="Email" required><br><br>
                <label for="nombre">Sugerencia o duda: </label> <br><br>
                <textarea placeholder="¡Escribe aqui tus dudas o sugerencias!" required></textarea><br><br>
                <button type="submit" name="enviar">Enviar</button>
            </form>
        </section>
    </main>

    <%- include("../partials/footer") %> <!--Footer-->
</body>
</html>