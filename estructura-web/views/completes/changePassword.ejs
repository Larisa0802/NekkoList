<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <link rel="icon" href="/favicon.ico">
    <title>NekkoList</title>
</head>

<body>
    <%- include ("../partials/header") %>

        <% if(user) { %>

            <h2 id="titC">Cambiar contraseña</h2>
            <main class="dataChangeDiv">
                <form id="changePassF">
                    <label for="password">Introduce tu antigua contraseña:</label>
                    <input type="password" id="oldPass" placeholder="Contraseña antigua" required>
                    <br><br>
                    <label for="newPassword">Introduce la nueva contraseña:</label>
                    <input type="password" id="newPass" placeholder="Nueva contraseña" required>
                    <br><br>
                    <label for="repetir">Repite la nueva contraseña:</label>
                    <input type="password" id="confirmPassword" placeholder="Confirmar contraseña" required>
                    <br><br>
                    <button type="submit">Cambiar contraseña</button>
                </form>

            </main>

            <div id="msj"></div>

            <%}else{%>
                <h3>Debes estar logueado</h3>
                <% } %>

                    <%- include("../partials/footer")%>

                        <script>
                            document.getElementById("changePassF").addEventListener("submit", async (e) => {
                                e.preventDefault()

                                const oldPassword = document.getElementById("oldPass").value
                                const newPassword = document.getElementById("newPass").value
                                const confirmPassword = document.getElementById("confirmPassword").value
                                const mensaje = document.getElementById("msj")

                                //Comprobacion antigua-nueva
                                if (oldPassword === newPassword) {
                                    mensaje.innerHTML = "<h2 id='error'>La nueva contraseña no puede ser igual a la antigua contraseña</h2>"
                                    return
                                }

                                //Comprobación de nueva contraseña y su confirmación
                                if (newPassword !== confirmPassword) {
                                    mensaje.innerHTML = "<h2 id='error'>Las contraseñas no coinciden</h2>"
                                    return
                                }

                                try {
                                    //Envia peticion a updatePassword
                                    const response = await fetch("/updatePassword", {
                                        method: "POST",
                                        headers: { "Content-Type": "application/json" },
                                        body: JSON.stringify({ oldPass: oldPassword, newPass: newPassword })
                                    })

                                    const data = await response.json();

                                    if (response.ok) {
                                        mensaje.innerHTML = "<h2 id='correct'>"+data.mensaje+"</h2>";
                                    } else {
                                        mensaje.innerHTML =  "<h2 id='error'>" + data.error + "</h2>"
                                    }

                                } catch (error) {
                                    mensaje.innerHTML = "<h2 id='error'>" + error.message + "</h2>"
                                }


                            })

                        </script>
</body>

</html>