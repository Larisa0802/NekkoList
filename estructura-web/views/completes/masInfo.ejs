<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="icon" href="/favicon.ico">
    <title><%= anime ? anime.titulo : "Detalles" %></title>
</head>

<body>
    <%- include("../partials/header") %>

    <% if (anime) { %>

    <div class="moreDetails">

        <img src="<%= anime.imagen %>" alt="<%= anime.titulo %>" width="250px" height="auto">

        <p>Título: <%= anime.titulo %></p>
        <p>Género: <%= anime.genero %></p>
        <p>ID: <%= anime.id %></p>
        <p>Episodios: <%= anime.episodios != null ? anime.episodios : "On-Going" %></p>

        <p>Personajes</p>

        <div class="characters-grid">
            <% if (char && char.length > 0) { %>
                <% char.forEach(c => { %>
                    <div class="character-card">
                        <img src="<%= c.character_img %>" alt="<%= c.name %>" class="character-img">

                        <div class="character-info">
                            <p class="character-name"><%= c.name %></p>
                            <p class="character-role"><%= c.role %></p>
                            <p class="character-va">VA: <%= c.voice_actor %></p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p>No hay personajes disponibles.</p>
            <% } %>
        </div>

        <p>Fecha: 
            <%= anime.fecha_pub 
                ? new Date(anime.fecha_pub).toISOString().split("T")[0] 
                : "Desconocida" 
            %>
        </p>

        <p>Sinopsis: <%= anime.descripcion %></p>

    </div>

    <% } else { %>
        <p>No hay información disponible del anime.</p>
    <% } %>

    <%- include("../partials/footer") %>

</body>

</html>
