<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <link rel="icon" href="/favicon.ico">
    <title>NekkoList - Login</title>
</head>

<body>
    <%- include("../partials/header") %> <!--Header-->

        <main class="login-div">

            <form action="/logIn" method="post">
                <p>Inicia sesión<img src="/img/loginPet.png" alt="loginPet" class="pet"></p>
                <p>Email: <input name="email" type="text" value="<%= log?.email || '' %>" id="email"></p>
                <p>Contraseña: <input name="password" type="password" value="<%= log?.pass || '' %>" id="pass"></p>
                <input type="submit" value="Entrar" id="btn"><br><br>
                <% if(errorL){ %>
                    <h3 id="error">
                        <%= errorL.mensaje %>
                    </h3>
                    <% } %>
            </form>

            <p><a href="/register">¿No tienes cuenta? Registrate aquí</a></p>

        </main>

        <%- include("../partials/footer") %> <!--Footer-->
       
</body>

</html>