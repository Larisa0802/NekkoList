<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="/estilos.css">
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <link rel="icon" href="/favicon.ico">
        <title>NekkoList - Catalogo</title>
    </head>

    <body>
        <%- include("../partials/header") %> <!--Header-->
        <h1 id="titC" style="margin-top:10%;">Catálogo<img
                src="/img/catalogPet.png" alt="catalogPet" class="pet"></h1>
        <h2 id="subtC">Explore el mundo de los animes libremente scrollenado, o
            filtrando por título o género en la
            barra de búsqueda de abajo. Feliz Experiencia!</h2>
        <input id="entrada" placeholder="Buscar anime por título o género">
        <% if(user && user.admin===true){ %>
        <a href="/jikanAnimeDatabase" class="btnCargar">Cargar Animes Jikan</a> 
        <% } %>
        <main class="catalogContainer">
            <% if (animes) { %>
            <% animes.forEach((anime)=> { %>
            <div class="tarjetaAnime" data-genero="<%= anime.genero %>">
                <img src="<%=anime.imagen%>" alt="<%= anime.titulo %>">
                <p class="titulo-anime" style="display: none;">
                    <%= anime.titulo %>
                </p>
                <p>
                    Titulo: <%= anime.titulo %> <br>
                    Genero: <%= anime.genero %> <br>
                </p>

                <button class="masInfo1 <% if(user){ %>ocultar<% } %>">Mas Informacion</button>
                <p class="descripcion">
                            Id: <%= anime.id %>  <br>
                            Episodios: <%= anime.episodios != null ? anime.episodios : "On-Going" %> <br>
                            Fecha: <%= new Date(anime.fecha_pub).toISOString().split("T")[0] %>   <br>
                            Sinopsis: <%= anime.descripcion %> 
                </p>           

                <% if (user) { %>
                <a href="/anime/<%= anime.id %>" class="masInfo">Más Información</a>
                <a href="/insertFav/<%= user %>&<%= anime.id %>"
                    class="favs">Añadir a Favoritos✨</a>

                <% } else { %>
                <a href="#" class="catalogoSinUser">Añadir a Favoritos✨</a>
                <% } %>
                <% if(user && user.admin===true){ %>
                <button class="editarAdmin" data-id="<%= anime.id %>"
                    data-titulo="<%= anime.titulo %>"
                    data-genero="<%= anime.genero %>"
                    data-descripcion="<%= anime.descripcion %>"
                    data-episodios="<%= anime.episodios %>">
                    Editar
                </button>
                <% } %>
            </div>

            <% }) %>
            <% } %>

        </main>

        <div id="editModal" class="modal" style="display: none;">
            <div class="modalContent">
                <h2 id="subtC" style="font-size:x-large;">Editar Anime</h2>
                <form method="POST" action="/update">
                    <input type="hidden" name="id" id="edit_id">

                    <label for="titulo">Título</label>
                    <input type="text" name="titulo" id="editTitulo">
                    <label for="genero">Género</label>
                    <input type="text" name="genero" id="editGenero">
                    <label for="episodios">Episodios</label>
                    <input type="text" name="episodios" id="editEpisodios">
                    <label for="descripcion">Descripción</label>
                    <input type="text" name="descripcion" id="editDescripcion">

                    <button type="submit">Guardar cambios</button>
                    <button type="button"
                        onclick="closeEditModal()">Cancelar</button>
                </form>
            </div>
        </div>

        <%- include("../partials/footer") %> <!--Footer-->

        <script>
                /*JS para la barra de búsqueda**/
                $(".masInfo1").on("click", function(){
                    const descripcion = $(this).siblings(".descripcion");
                    descripcion.slideToggle();

                    if(!user){

                    }

                    if($(this).text() === "Más Información"){
                        $(this).text("Ocultar Información");
                    } else {
                        $(this).text("Más Información");
                    }
                });

                $("#entrada").on("keyup", function () {
                    let query = $(this).val().toLowerCase().trim();

                    $(".tarjetaAnime").each(function () {
                        let $card = $(this);
                        let title = $card.find(".titulo-anime").text().toLowerCase();
                        let genero = $card.data("genero") ? $card.data("genero").toLowerCase() : "";

                        if (title.includes(query) || genero.includes(query)) {
                            $card.show();
                        } else {
                            $card.hide();
                        }
                    });
                });

                /*JS para botones*/
                $(".favs").on("click", function () {
                    let boton = $(this);

                    if (boton.hasClass('añadido')) {
                        boton.text('Añadir a Favoritos✨');
                        boton.css({
                            "background-color": "",
                            "color": ""
                        });
                        boton.removeClass('añadido');


                    } else {
                        //cambiar a añadido
                        boton.text('Añadido a Favoritos✨');


                        //se modifica el color
                        boton.css({
                            "background-color": "#3f6584a9",
                            "color": "grey"
                        });

                        boton.addClass("añadido");
                    }
                });

                $(".catalogoSinUser").on("click", function () {
                    alert("Debes loguearte primero!")
                });

                window.onclick = function (event) {
                    const modal = document.getElementById("editModal")
                    if (event.target === modal) {
                        modal.style.display = "none";
                    }
                }

                $(".editarAdmin").on("click", function () {
                    const id = $(this).data("id")
                    const titulo = $(this).data("titulo")
                    const genero = $(this).data("genero")
                    const descripcion = $(this).data("descripcion")
                    const episodios = $(this).data("episodios")

                    document.getElementById("edit_id").value = id;
                    document.getElementById("editTitulo").value = titulo;
                    document.getElementById("editGenero").value = genero;
                    document.getElementById("editDescripcion").value = descripcion;
                    document.getElementById("editEpisodios").value = episodios;

                    document.getElementById("editModal").style.display = "block";
                })

                function closeEditModal() {
                    document.getElementById("editModal").style.display = "none";
                }

            </script>
    </body>

</html>