<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalogo</title>
</head>
<body>
    <%- include("../partials/header") %> <!--Header-->

    <% if (animes) { %>
        <% animes.forEach((anime) => { %>
            <p>Titulo: <%= anime.titulo %> Id: <%= anime.id %>  Genero: <%= anime.genero %>   Episodios: <%= anime.episodios != null ? anime.episodios : "On-Going" %> Fecha: <%= new Date(anime.fecha_pub).toISOString().split("T")[0] %>   Sinopsis: <%= anime.descripcion %> </p>
            <img src="<%=anime.imagen%>">
            <button id="addFav" data-id="<%= anime.id %>">Añadir Fav</button>
        <% }) %>
    
    <% } %>

    <%- include("../partials/footer") %> <!--Footer-->
</body>
</html>