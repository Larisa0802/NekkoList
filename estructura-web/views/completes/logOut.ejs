<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/estilos.css">
    <link rel="icon" href="/favicon.ico">
    <title>NekkoList - Logout</title>
</head>

<body>
        <%- include("../partials/header") %> <!--Header-->

    <%if(user){%>

    <h1 id="titC">¿Deseas cerrar sesión?</h1>
    <main class="logOutDiv">
        <form action="/signOutUser" method="post">
        <p>Cerrar Sesión:</p>
        <p id="uid">
            <%= user ? user.uuid : "" %>
        </p>
        <input type="submit" value="Cerrar sesión" id="cerrarSesion">
    </form>
    </main>
    <%}else{%>
        <h3 id="error">Debes estar logueado</h3>
        <%}%>
                <%- include("../partials/footer") %> <!--Footer-->

</body>

</html>
