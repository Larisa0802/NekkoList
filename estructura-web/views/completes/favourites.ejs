<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Favoritos</title>
</head>
<body>
    <%- include("../partials/header") %> <!--Header-->

    <h1>Favoritos</h1>
    <% if (favData) { %>
        <% favData.forEach((animeFav) => { %>
            <p>Titulo: <%= animeFav.animeData.titulo %> Id: <%= animeFav.anime_id %>  Genero: <%= animeFav.animeData.genero %>   Episodios: <%= animeFav.animeData.episodios != null ? animeFav.animeData.episodios : "On-Going" %> Fecha: <%= new Date(animeFav.animeData.fecha_pub).toISOString().split("T")[0] %>   Sinopsis: <%= animeFav.animeData.descripcion %> </p>
            <img src="<%=animeFav.animeData.imagen%>">
            <a href="/deleteFav/<%= user %>&<%= animeFav.anime_id %>">Eliminar de Favoritos</a>
        <% }) %>
    
    <% } %>

    <%- include("../partials/footer") %> <!--Footer-->
</body>
</html>